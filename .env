# ========================================================
# INVENTO Multi-Concern Inventory System - Environment Config
# ========================================================

APP_NAME="INVENTO Multi-Concern ERP"
APP_ENV=local
APP_URL=http://localhost/inventory/
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=true

# Database Settings (XAMPP / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invento_db
DB_USERNAME=root
DB_PASSWORD=

# Session Settings
SESSION_NAME=INVENTO_SESSID
SESSION_LIFETIME=86400
