# ========================================================
# INVENTO Multi-Concern Inventory System - Environment Config Example
# ========================================================

APP_NAME="INVENTO Multi-Concern ERP"
APP_ENV=local
APP_URL=http://localhost/INVENTO/
APP_TIMEZONE=Asia/Kolkata
APP_DEBUG=true

# Database Settings (XAMPP / MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=invento_db
DB_USERNAME=root
DB_PASSWORD=12345

# Session Settings
SESSION_NAME=INVENTO_SESSID
SESSION_LIFETIME=86400

# ========================================================
# Cloudinary Image Storage Settings
# ========================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>
